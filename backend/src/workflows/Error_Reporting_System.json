      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const parts = $json.content?.parts ?? [];\nconst rawResponse = parts.map(p => p.text ?? '').join('');\n\nconst cleaned = rawResponse\n  .trim()\n  .replace(/^```json\\s*/i, '')\n  .replace(/^```\\s*/i, '')\n  .replace(/```\\s*$/i, '')\n  .trim();\n\nlet parsed = null;\nlet parseSuccess = false;\nlet parseError = null;\n\ntry {\n  parsed = JSON.parse(cleaned);\n  parseSuccess = true;\n} catch (err) {\n  parseError = err.message;\n}\n\nreturn {\n  json: {\n    rawResponse,\n    parseSuccess,\n    parseError,\n    analysis: parsed,\n    analysedAt: new Date().toISOString(),\n    modelName: \"gemini-3-flash-preview\",\n    promptVersion: \"v1\"\n  }\n};"
      },

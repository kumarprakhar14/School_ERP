    {
      "parameters": {
        "jsCode": "const body = $(\"Webhook\").first().json;\nconst analysis = $('Code (Parse & Validate AI Response)').first().json.analysis;\n\nconsole.log(body);\n\nconst severity = analysis?.severity ?? \"Unknown\";\n\nconst severityColors = {\n  Critical: \"#dc2626\",\n  High: \"#ea580c\",\n  Medium: \"#ca8a04\",\n  Low: \"#16a34a\",\n  Unknown: \"#6b7280\"\n};\n\nconst color = severityColors[severity] ?? severityColors.Unknown;\n\nconst confidence =\n  analysis?.confidence != null\n    ? `${Math.round(analysis.confidence * 100)}%`\n    : \"N/A\";\n\nconst affectedFiles = (analysis?.affectedFiles ?? [])\n  .map(\n    file =>\n      `<li><code>${file.file}${\n        file.line ? `:${file.line}` : \"\"\n      }</code> <small>(${file.confidence})</small></li>`\n  )\n  .join(\"\");\n\nconst tags = (analysis?.tags ?? [])\n  .map(\n    tag =>\n      `<span style=\"display:inline-block;padding:4px 8px;margin:2px;border-radius:4px;background:#eef2ff;font-size:12px;\">${tag}</span>`\n  )\n  .join(\"\");\n\nconst subject = `🚨 [${severity}] Production Incident - ${body.httpMethod} ${body.route}`;\n\nconst html = `\n<!DOCTYPE html>\n<html>\n\n<body style=\"font-family:Arial,Helvetica,sans-serif;background:#f4f4f4;padding:30px;\">\n\n<div style=\"max-width:900px;margin:auto;background:white;border-radius:10px;overflow:hidden;border:1px solid #ddd;\">\n\n<div style=\"background:${color};padding:20px;color:white;\">\n<h1 style=\"margin:0;\">🚨 Production Incident</h1>\n<div style=\"margin-top:8px;font-size:18px;font-weight:bold;\">\n${severity}\n</div>\n</div>\n\n<div style=\"padding:25px;\">\n\n<h2>Incident Information</h2>\n\n<table width=\"100%\" cellspacing=\"0\" cellpadding=\"6\">\n\n<tr>\n<td><strong>Timestamp</strong></td>\n<td>${body.timestamp}</td>\n</tr>\n\n<tr>\n<td><strong>Environment</strong></td>\n<td>${body.environment}</td>\n</tr>\n\n<tr>\n<td><strong>Request ID</strong></td>\n<td><code>${body.requestId}</code></td>\n</tr>\n\n<tr>\n<td><strong>Occurrence Count</strong></td>\n<td>${body.occurrenceCount}</td>\n</tr>\n\n<tr>\n<td><strong>Fingerprint</strong></td>\n<td><code>${body.fingerprint}</code></td>\n</tr>\n\n</table>\n\n<hr>\n\n<h2>API Information</h2>\n\n<table width=\"100%\" cellspacing=\"0\" cellpadding=\"6\">\n\n<tr>\n<td><strong>Endpoint</strong></td>\n<td>${body.httpMethod} ${body.route}</td>\n</tr>\n\n<tr>\n<td><strong>Status Code</strong></td>\n<td>${body.statusCode}</td>\n</tr>\n\n</table>\n\n<hr>\n\n<h2>School & User</h2>\n\n<table width=\"100%\" cellspacing=\"0\" cellpadding=\"6\">\n\n<tr>\n<td><strong>School</strong></td>\n<td>${body.school?.name ?? \"-\"}</td>\n</tr>\n\n<tr>\n<td><strong>School ID</strong></td>\n<td>${body.school?.id ?? \"-\"}</td>\n</tr>\n\n<tr>\n<td><strong>User</strong></td>\n<td>${body.user?.id ?? \"-\"}</td>\n</tr>\n\n<tr>\n<td><strong>Role</strong></td>\n<td>${body.user?.role ?? \"-\"}</td>\n</tr>\n\n</table>\n\n<hr>\n\n<h2>AI Analysis</h2>\n\n<table width=\"100%\" cellspacing=\"0\" cellpadding=\"6\">\n\n<tr>\n<td width=\"220\"><strong>Summary</strong></td>\n<td>${analysis?.summary ?? \"-\"}</td>\n</tr>\n\n<tr>\n<td><strong>Root Cause</strong></td>\n<td>${analysis?.rootCause ?? \"-\"}</td>\n</tr>\n\n<tr>\n<td><strong>Likely Reason</strong></td>\n<td>${analysis?.likelyReason ?? \"-\"}</td>\n</tr>\n\n<tr>\n<td><strong>Customer Impact</strong></td>\n<td>${analysis?.customerImpact ?? \"-\"}</td>\n</tr>\n\n<tr>\n<td><strong>Recommended Fix</strong></td>\n<td>${analysis?.recommendedFix ?? \"-\"}</td>\n</tr>\n\n<tr>\n<td><strong>Confidence</strong></td>\n<td>${confidence}</td>\n</tr>\n\n<tr>\n<td><strong>Requires Immediate Attention</strong></td>\n<td>${analysis?.requiresImmediateAttention ? \"✅ Yes\" : \"No\"}</td>\n</tr>\n\n<tr>\n<td><strong>Regression</strong></td>\n<td>${analysis?.isLikelyRegression ? \"Likely\" : \"No\"}</td>\n</tr>\n\n</table>\n\n<hr>\n\n<h2>Affected Files</h2>\n\n<ul>\n\n${affectedFiles || \"<li>No files identified.</li>\"}\n\n</ul>\n\n<hr>\n\n<h2>Tags</h2>\n\n${tags || \"None\"}\n\n<hr>\n\n<h2>Server Information</h2>\n\n<table width=\"100%\" cellspacing=\"0\" cellpadding=\"6\">\n\n<tr>\n<td><strong>Version</strong></td>\n<td>${body.serverMetadata?.appVersion ?? \"-\"}</td>\n</tr>\n\n<tr>\n<td><strong>Git Commit</strong></td>\n<td><code>${body.serverMetadata?.gitCommit ?? \"-\"}</code></td>\n</tr>\n\n<tr>\n<td><strong>Hostname</strong></td>\n<td>${body.serverMetadata?.hostname ?? \"-\"}</td>\n</tr>\n\n</table>\n\n<hr>\n\n<h2>Error</h2>\n\n<p><strong>${body.error?.name}</strong></p>\n\n<p>${body.error?.message}</p>\n\n<h2>Stack Trace</h2>\n\n<pre style=\"\nbackground:#111827;\ncolor:#f9fafb;\npadding:16px;\nborder-radius:8px;\noverflow:auto;\nfont-size:12px;\nline-height:1.5;\nwhite-space:pre-wrap;\n\">${body.error?.stackTrace}</pre>\n\n</div>\n\n<div style=\"padding:18px;background:#f9fafb;text-align:center;font-size:12px;color:#666;\">\nGenerated automatically by School Chakra Production Incident Pipeline\n</div>\n\n</div>\n\n</body>\n\n</html>\n`;\n\nreturn [\n  {\n    json: {\n      subject,\n      html,\n      severity\n      // body\n    }\n  }\n];"
      },

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
  ACCOUNTS
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

enum BugStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum FeeStatus {
  PENDING
  PAID
  OVERDUE
}

enum PaymentStatus {
  SUCCESS
  PENDING_VERIFICATION
  REJECTED
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  GRACE_PERIOD
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// -----------------------------------------------------------------------------
// CORE ENTITIES
// -----------------------------------------------------------------------------

model School {
  id         String       @id @default(uuid())
  code       String       @unique
  name       String
  status     SchoolStatus @default(ACTIVE)
  validUntil DateTime
  isArchived Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  settings      SchoolSettings?
  users         User[]
  classes       Class[]
  notices       Notice[]
  assignments   Assignment[]
  subjects      Subject[]
  periods       Period[]
  academicYears AcademicYear[]
  subscriptions SchoolSubscription[]
  featureOverrides SchoolFeatureOverride[]
  paymentOrders PaymentOrder[]
}

model SchoolSettings {
  id          String   @id @default(uuid())
  schoolId    String   @unique
  school      School   @relation(fields: [schoolId], references: [id])
  logoUrl      String?
  themeColor   String   @default("#3b82f6") // Tailwind blue-500
  description  String?
  contactInfo  String?
  merchantName String?
  upiId        String?
  updatedAt    DateTime @updatedAt
}

model User {
  id             String   @id @default(uuid())
  schoolId       String? // Nullable for SUPER_ADMIN
  school         School?  @relation(fields: [schoolId], references: [id])
  erpId          String
  passwordHash   String
  role           UserRole
  name           String
  profilePicUrl  String?
  contactDetails String?
  isActive       Boolean  @default(true)
  isArchived     Boolean  @default(false)
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  studentProfile StudentProfile?
  teacherProfile TeacherProfile?

  authoredNotices Notice[]
  feeInvoices     FeeInvoice[]           @relation("FeeInvoiceStudent")
  createdInvoices FeeInvoice[]           @relation("FeeInvoiceCreator")
  receivedPayments Payment[]             @relation("PaymentReceiver")
  attendances     Attendance[]
  submissions     AssignmentSubmission[]
  reportedBugs    BugReport[]
  pushSubscriptions       PushSubscription[]
  notificationPreferences Json?
  userNotifications       UserNotification[]
  activatedSubscriptions  SchoolSubscription[] @relation("SubscriptionActivator")
  updatedOverrides        SchoolFeatureOverride[] @relation("OverrideUpdater")
  updatedGlobalFlags      GlobalFeatureFlag[] @relation("GlobalFlagUpdater")

  @@unique([schoolId, erpId]) // Unique per school
  @@index([schoolId, name])
  @@index([schoolId, role])
}

// -----------------------------------------------------------------------------
// PROFILES
// -----------------------------------------------------------------------------

model StudentProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  sectionId     String
  section       Section   @relation(fields: [sectionId], references: [id])
  admissionDate DateTime?

  attendances Attendance[]

  @@index([sectionId])
}

model TeacherProfile {
  id          String  @id @default(uuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  designation String?

  timeTableEntries   TimeTableEntry[]
  teacherAssignments TeacherAssignment[]
}

// -----------------------------------------------------------------------------
// ACADEMIC STRUCTURE
// -----------------------------------------------------------------------------

model Class {
  id         String  @id @default(uuid())
  schoolId   String
  school     School  @relation(fields: [schoolId], references: [id])
  name       String // e.g., "10", "12"
  isArchived Boolean @default(false)

  sections         Section[]
  timeTableEntries TimeTableEntry[]

  @@unique([schoolId, name])
}

model Section {
  id         String  @id @default(uuid())
  classId    String
  class      Class   @relation(fields: [classId], references: [id])
  name       String // e.g., "A", "B"
  isArchived Boolean @default(false)

  students           StudentProfile[]
  assignments        Assignment[]
  attendances        Attendance[]
  timeTableEntries   TimeTableEntry[]
  teacherAssignments TeacherAssignment[]

  @@unique([classId, name])
}

// -----------------------------------------------------------------------------
// MODULES
// -----------------------------------------------------------------------------

model Subject {
  id         String  @id @default(uuid())
  schoolId   String
  school     School  @relation(fields: [schoolId], references: [id])
  name       String
  code       String?
  isArchived Boolean @default(false)

  timeTableEntries   TimeTableEntry[]
  teacherAssignments TeacherAssignment[]

  @@unique([schoolId, name])
}

model Period {
  id        String @id @default(uuid())
  schoolId  String
  school    School @relation(fields: [schoolId], references: [id])
  name      String // e.g., "Period 1", "Lunch Break"
  startTime String // e.g., "08:00"
  endTime   String // e.g., "08:45"

  timeTableEntries TimeTableEntry[]

  @@unique([schoolId, name])
}

model TimeTableEntry {
  id        String         @id @default(uuid())
  classId   String
  class     Class          @relation(fields: [classId], references: [id])
  sectionId String
  section   Section        @relation(fields: [sectionId], references: [id])
  subjectId String
  subject   Subject        @relation(fields: [subjectId], references: [id])
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id])
  periodId  String
  period    Period         @relation(fields: [periodId], references: [id])
  dayOfWeek DayOfWeek

  @@unique([classId, sectionId, periodId, dayOfWeek])
  @@unique([teacherId, periodId, dayOfWeek])
  @@index([sectionId])
}

model Attendance {
  id        String           @id @default(uuid())
  sectionId String
  section   Section          @relation(fields: [sectionId], references: [id])
  studentId String
  student   User             @relation(fields: [studentId], references: [id])
  date      DateTime // Stored as Date only
  status    AttendanceStatus
  isLocked  Boolean          @default(false)
  isSaved   Boolean          @default(false)
  lockedAt  DateTime?
  remarks   String?

  createdBy        String? // Teacher ID
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  studentProfile   StudentProfile? @relation(fields: [studentProfileId], references: [id])
  studentProfileId String?

  @@unique([sectionId, studentId, date])
  @@index([sectionId])
  @@index([sectionId, date])
}

model Assignment {
  id          String   @id @default(uuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id])
  title       String
  description String?
  fileUrl     String?
  dueDate     DateTime
  isArchived  Boolean  @default(false)

  createdBy String? // Teacher ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions AssignmentSubmission[]

  @@index([sectionId])
  @@index([schoolId, title])
  @@index([dueDate])
}

model AssignmentSubmission {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  studentId    String
  student      User       @relation(fields: [studentId], references: [id])
  fileUrl      String
  submittedAt  DateTime   @default(now())

  @@unique([assignmentId, studentId])
}

// -----------------------------------------------------------------------------
// ACADEMIC OPERATIONS
// -----------------------------------------------------------------------------

model AcademicYear {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  name      String // e.g., "2026-27"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherAssignments TeacherAssignment[]

  @@unique([schoolId, name])
}

model TeacherAssignment {
  id             String         @id @default(uuid())
  teacherId      String
  teacher        TeacherProfile @relation(fields: [teacherId], references: [id])
  sectionId      String
  section        Section        @relation(fields: [sectionId], references: [id])
  subjectId      String? // Nullable because some assigned sections might not have a specific subject mapped initially
  subject        Subject?       @relation(fields: [subjectId], references: [id])
  academicYearId String
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([teacherId, sectionId, subjectId, academicYearId])
  @@index([sectionId])
}

model Notice {
  id            String     @id @default(uuid())
  schoolId      String
  school        School     @relation(fields: [schoolId], references: [id])
  title         String
  content       String
  attachmentUrl String?
  targetRoles   UserRole[] // Array of roles this notice is meant for
  isArchived    Boolean    @default(false)
  createdBy     String? // Author User ID
  author        User?      @relation(fields: [createdBy], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([schoolId, title])
  @@index([schoolId, createdAt])
}



model FeeStructure {
  id         String @id @default(uuid())
  schoolId   String
  name       String
  isActive   Boolean @default(true)
  createdAt  DateTime @default(now())

  items      FeeStructureItems[]
}

model FeeStructureItems {
  id              String       @id @default(uuid())
  feeStructureId  String
  feeStructure    FeeStructure @relation(fields: [feeStructureId], references: [id])
  name            String
  amount          Int
}

model FeeInvoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  schoolId      String
  studentId     String
  student       User     @relation("FeeInvoiceStudent", fields: [studentId], references: [id])
  month         Int
  year          Int
  totalAmount   Int
  dueDate       DateTime?
  remarks       String?
  createdBy     String?
  creator       User?    @relation("FeeInvoiceCreator", fields: [createdBy], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  payments      Payment[]

  @@index([studentId])
  @@index([schoolId])
  @@index([schoolId, invoiceNumber])
  @@index([schoolId, month, year])
}

model Payment {
  id            String     @id @default(uuid())
  schoolId      String
  invoiceId     String
  invoice       FeeInvoice @relation(fields: [invoiceId], references: [id])
  amount        Int
  paymentMode   String?
  referenceNo   String?
  utr           String?
  screenshotUrl String?
  remarks       String?
  status        PaymentStatus @default(SUCCESS)
  paidAt        DateTime
  receivedBy    String?
  receiver      User?         @relation("PaymentReceiver", fields: [receivedBy], references: [id])
  createdAt     DateTime      @default(now())

  @@index([invoiceId])
  @@index([schoolId])
  @@index([schoolId, referenceNo])
}

model BugReport {
  id          String    @id @default(uuid())
  title       String
  description String    @db.Text
  screenshots String[]
  status      BugStatus @default(OPEN)

  reportedById String
  reportedBy   User   @relation(fields: [reportedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ImportJob {
  id                 String    @id @default(uuid())
  schoolId           String
  type               String
  status             String
  totalRows          Int       @default(0)
  matchedRows        Int       @default(0)
  ambiguousRows      Int       @default(0)
  unmatchedRows      Int       @default(0)
  resolvedRows       Int       @default(0)
  spreadsheetData    Json?
  matchingData       Json?
  previewData        Json?
  resolvedOverrides  Json?
  uploadedFileMeta   Json?
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
}

model SearchLog {
  id        String   @id @default(uuid())
  query     String
  role      UserRole
  schoolId  String?
  createdAt DateTime @default(now())

  @@index([schoolId])
}

// -----------------------------------------------------------------------------
// PUSH NOTIFICATIONS
// -----------------------------------------------------------------------------

model PushSubscription {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId     String?
  endpoint     String   @unique
  subscription Json
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([schoolId])
}

model NotificationLog {
  id         String   @id @default(uuid())
  schoolId   String?
  title      String
  body       String
  entityType String?  // e.g., "notice", "assignment", "invoice", "payment"
  entityId   String?  // UUID of the referenced entity
  targetType String
  targetId   String?
  sentCount  Int      @default(0)
  createdAt  DateTime @default(now())

  userNotifications UserNotification[]

  @@index([schoolId])
  @@index([createdAt])
}

model UserNotification {
  id                String          @id @default(uuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationLogId String
  notificationLog   NotificationLog @relation(fields: [notificationLogId], references: [id], onDelete: Cascade)
  isRead            Boolean         @default(false)
  readAt            DateTime?
  createdAt         DateTime        @default(now())

  @@index([userId])
  @@index([userId, isRead])
}

// -----------------------------------------------------------------------------
// SUBSCRIPTIONS & FEATURES
// -----------------------------------------------------------------------------

model SubscriptionPlan {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String?
  badge           String?
  isDefault       Boolean  @default(false)
  isPublic        Boolean  @default(true)
  isActive        Boolean  @default(true)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pricing         PlanPricing[]
  features        PlanFeature[]
  subscriptions   SchoolSubscription[]
}

model PlanPricing {
  id                 String           @id @default(uuid())
  planId             String
  plan               SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  interval           String           // 'MONTHLY', 'YEARLY', 'QUARTERLY', 'ONCE'
  price              Float
  currency           String           @default("INR")
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  subscriptions      SchoolSubscription[]
  paymentOrders      PaymentOrder[]

  @@unique([planId, interval])
}

model Feature {
  id           String   @id @default(uuid())
  key          String   @unique
  name         String
  category     String
  description  String?
  icon         String?
  displayOrder Int      @default(0)
  isCore       Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  planFeatures    PlanFeature[]
  schoolOverrides SchoolFeatureOverride[]
  globalFlags     GlobalFeatureFlag[]
}

model PlanFeature {
  id                 String           @id @default(uuid())
  planId             String
  plan               SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureId          String
  feature            Feature          @relation(fields: [featureId], references: [id], onDelete: Cascade)
  isEnabled          Boolean          @default(true)
  limitValue         Int?             // Numeric limit
  limitUnit          String?          // e.g. "STUDENTS", "SMS_MONTHLY"
  metadata           Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([planId, featureId])
}

model SchoolSubscription {
  id              String             @id @default(uuid())
  schoolId        String
  school          School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planId          String
  plan            SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  planPricingId   String?
  planPricing     PlanPricing?       @relation(fields: [planPricingId], references: [id])
  status          SubscriptionStatus @default(ACTIVE)
  startsAt        DateTime
  expiresAt       DateTime?
  trialEndsAt     DateTime?
  renewalDate     DateTime?
  activatedById   String?
  activatedBy     User?              @relation("SubscriptionActivator", fields: [activatedById], references: [id])
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  paymentTransactions PaymentTransaction[]

  @@index([schoolId])
}

model SchoolFeatureOverride {
  id           String          @id @default(uuid())
  schoolId     String
  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  featureId    String
  feature      Feature         @relation(fields: [featureId], references: [id], onDelete: Cascade)
  isEnabled    Boolean         @default(true)
  limitValue   Int?
  reason       String?
  expiresAt    DateTime?
  updatedById  String?
  updatedBy    User?           @relation("OverrideUpdater", fields: [updatedById], references: [id])
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([schoolId, featureId])
}

model GlobalFeatureFlag {
  id           String          @id @default(uuid())
  featureId    String
  feature      Feature         @relation(fields: [featureId], references: [id], onDelete: Cascade)
  isEnabled    Boolean         @default(true)
  isActive     Boolean         @default(true)
  reason       String?
  updatedById  String?
  updatedBy    User?           @relation("GlobalFlagUpdater", fields: [updatedById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

// --------------------------------------------------------------------------------
// Phase IVA: Provider-Agnostic Billing Infrastructure
// --------------------------------------------------------------------------------

enum PaymentOrderPurpose {
  SUBSCRIPTION_PURCHASE
  SUBSCRIPTION_RENEWAL
  SUBSCRIPTION_UPGRADE
  SUBSCRIPTION_DOWNGRADE
  MANUAL_PAYMENT
  ADDON_PURCHASE
}

enum PaymentOrderStatus {
  CREATED
  AWAITING_PAYMENT
  PROCESSING
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

enum TransactionStatus {
  SUCCESS
  FAILED
}

model PaymentOrder {
  id              String             @id @default(uuid())
  schoolId        String
  school          School             @relation(fields: [schoolId], references: [id])
  planPricingId   String
  planPricing     PlanPricing        @relation(fields: [planPricingId], references: [id])
  purpose         PaymentOrderPurpose @default(SUBSCRIPTION_PURCHASE)
  amount          Decimal            @db.Decimal(10, 2)
  currency        String
  provider        String?            // e.g., 'DUMMY', 'STRIPE', 'RAZORPAY'
  providerOrderId String?
  status          PaymentOrderStatus @default(CREATED)
  metadata        Json?
  expiresAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  transactions    PaymentTransaction[]

  @@index([schoolId])
}

model PaymentTransaction {
  id                      String            @id @default(uuid())
  paymentOrderId          String
  paymentOrder            PaymentOrder      @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)
  activatedSubscriptionId String?
  activatedSubscription   SchoolSubscription? @relation(fields: [activatedSubscriptionId], references: [id])
  provider                String
  providerPaymentId       String?
  providerReference       String?
  amount                  Decimal           @db.Decimal(10, 2)
  currency                String
  status                  TransactionStatus
  rawPayload              Json?
  paidAt                  DateTime?
  createdAt               DateTime          @default(now())

  @@index([paymentOrderId])
}

